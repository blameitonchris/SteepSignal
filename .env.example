# Server only. Never put real values in Git or frontend configuration.
YOUTUBE_API_KEY=replace-with-server-api-key
RESEARCH_ACCESS_CODE=replace-with-a-random-secret-at-least-16-characters
PORT=3000
# Optional: allow existing GitHub Pages frontend. This is an origin, not a URL path.
ALLOWED_ORIGINS=https://blameitonchris.github.io
# Conservative budget: one search returns at most 25 videos. Restart resets this counter;
# also set the Google Cloud project quota to protect usage across restarts/instances.
YOUTUBE_DAILY_SEARCH_LIMIT=10
